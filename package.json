{
  "name": "dashboard-agent",
  "version": "1.1.0",
  "description": "Server agent — dials out to the dashboard hub and proxies local server management over a tunnel.",
  "main": "tunnel.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tunnel.js",
    "link": "node link.js",
    "check": "node check.js",
    "sums": "node tools/make-sums.js",
    "test": "node tools/make-sums.js --check && node --test --test-concurrency=1 test/local-api.test.js test/installer.test.js"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.11.14",
    "archiver": "^8.0.0",
    "express": "^4.18.2",
    "ssh2": "^1.16.0",
    "tar": "7.5.22",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  }
}
